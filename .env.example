# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Local dev (Postgres from docker-compose exposed on localhost)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# Inside docker-compose the backend uses the service name instead:
# DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag
